{"/demo/examples/app.js":"// A small demo service: an entry point calls through a few layers down to where things can go wrong.\nexport async function main() {\n  await handleRequest();\n}\n\nasync function handleRequest() {\n  try {\n    await processOrder();\n  } catch (err) {\n    throw err;\n  }\n}\n\nasync function processOrder() {\n  await chargeCard();\n}\n\nasync function chargeCard() {\n  if (!cardIsValid()) fatal('card declined');\n  throw new Error('card declined');\n}\n\nfunction cardIsValid() {\n  return false;\n}\n\nfunction fatal(message) {\n  console.error(message);\n  process.exit(1);\n}\n\n// reads the API key from the environment first, then a local settings file\nfunction loadApiKey() {\n  return process.env.SYS1GREP_API_KEY || readSettingsFile().apiKey;\n}\n\nfunction readSettingsFile() {\n  return { apiKey: '' };\n}\n\nfunction tryOptionalStep() {\n  try {\n    riskyStep();\n  } catch (err) {} // ignored: this step is optional and failing it is not fatal\n}\n\nfunction riskyStep() {\n  return true;\n}\n","/demo/examples/app.py":"\"\"\"A small demo CLI: the same kind of call chain as app.js, in Python.\"\"\"\nimport os\nimport sys\n\n\ndef main():\n    run_job()\n\n\ndef run_job():\n    try:\n        execute()\n    except Exception:\n        raise\n\n\ndef execute():\n    if not is_ready():\n        raise RuntimeError('not ready')\n    charge()\n\n\ndef is_ready():\n    return False\n\n\ndef charge():\n    if not confirm_charge():\n        sys.exit(1)\n    raise RuntimeError('charge failed')\n\n\ndef confirm_charge():\n    return False\n\n\ndef load_api_key():\n    # reads the API key from the environment first, then a local settings file\n    return os.environ.get('SYS1GREP_API_KEY') or read_settings_file()\n\n\ndef read_settings_file():\n    return ''\n\n\ndef try_optional_step():\n    try:\n        risky_step()\n    except Exception:\n        pass  # ignored: optional, not fatal\n\n\ndef risky_step():\n    return True\n","/demo/examples/logs.txt":"2026-01-05 03:12:01 INFO  server started, listening on port 8080\n2026-01-05 03:12:04 INFO  connected to the primary database\n2026-01-05 03:14:40 WARN  slow query took 2800ms: SELECT * FROM orders WHERE status = 'pending'\n2026-01-05 03:20:11 ERROR connection reset by peer while calling the payment service\n2026-01-05 03:20:12 INFO  retrying the payment request (attempt 2 of 3)\n2026-01-05 03:20:18 ERROR timeout after 5000ms waiting for the payment service\n2026-01-05 03:20:19 INFO  retrying the payment request (attempt 3 of 3)\n2026-01-05 03:20:25 FATAL giving up after 3 attempts: the payment service is unreachable\n2026-01-05 04:02:00 INFO  nightly backup completed\n2026-01-05 04:05:30 WARN  disk usage at 92% on /var/log\n2026-01-05 04:10:44 ERROR DNS lookup failed for the billing API\n2026-01-05 04:10:46 INFO  DNS lookup succeeded on retry\n2026-01-05 05:00:00 ERROR health check failed: no response from the application server\n2026-01-05 05:00:05 ERROR health check failed again: no response from the application server\n2026-01-05 05:00:10 FATAL marking the application server as down after 2 failed health checks\n2026-01-05 05:30:00 INFO  the application server is back and answering health checks\n2026-01-05 06:00:00 WARN  an admin ran DROP TABLE sessions; on the staging database by mistake\n2026-01-05 06:05:00 INFO  restored the sessions table from last night's backup\n2026-01-05 07:00:00 INFO  it is a quiet morning, nothing else to report\n","/demo/examples/prose.txt":"I have to admit, the bug was my fault: I shipped the migration without testing it on a copy of production data first.\nLooking back, I should have reviewed the diff more carefully before merging; the mistake was mine, not the reviewer's.\nThe weather today is mild, with a light breeze from the west and clear skies through the evening.\nLunch today was a simple rice bowl with grilled vegetables from the place around the corner.\nNext Friday is a public holiday, so the office will be closed for the long weekend.\n会議は明日の10時からに変更になりました。資料は前日までに共有してください。\n今日の天気は晴れ、最高気温は28度の見込みです。\n料金プランの変更方法については、設定画面の「プラン」から行えます。\n振り返ると、あのバグは自分のミスでした。テストを十分にせずにリリースしてしまったのが原因です。\n新機能のリリースは来月に延期されましたが、理由は品質を優先したためです。\n","/demo/examples/tickets.txt":"Ticket #4821 (support, EN): I want my money back. The item arrived broken and nobody answered my emails.\nTicket #4822 (support, EN): Could you change the delivery address for order #910? I moved last week.\nTicket #4823 (support, EN): This is infuriating. Three days with no reply and my account is still locked.\nTicket #4824 (support, EN): Thanks so much, the replacement part fixed it and the team was lovely.\nTicket #4825 (support, EN): The app crashed once but it worked fine the second time, no need for a refund.\nチケット #4826（サポート, JA）: 注文した覚えのない請求が来ています。至急確認してください。本当に困っています。\nチケット #4827（サポート, JA）: 配送先の住所を変更したいです。来週には新しい住所に届けてほしいです。\nチケット #4828（サポート, JA）: 対応いただきありがとうございました。問題は解決しました。\nチケット #4829（サポート, JA）: サポートに何度連絡しても返事がなく、とても腹が立っています。\n","/sys1grep/templates/default.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>{{title}}</title>\n<style>\n:root {\n  --bg: #fbfaf7;\n  --fg: #1f1e1c;\n  --muted: #6b6760;\n  --rule: #e3dfd7;\n  --code-bg: #f3f0e9;\n  --track: #e8e4dc;\n  --accent: #0f6e66;\n  --focus: #0f6e66;\n  --chrome: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Hiragino Sans\", \"Noto Sans CJK JP\", \"Noto Sans\", sans-serif;\n  --code: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #151514;\n    --fg: #e9e7e2;\n    --muted: #9c978e;\n    --rule: #2d2c29;\n    --code-bg: #1d1c1a;\n    --track: #2f2e2a;\n    --accent: #5cc2b3;\n    --focus: #7fd6c9;\n  }\n}\n* { box-sizing: border-box; }\nhtml { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }\nbody {\n  margin: 0;\n  background: var(--bg);\n  color: var(--fg);\n  font: 16px/1.5 var(--chrome);\n}\n.page { max-width: 90ch; margin: 0 auto; padding: 40px 16px 64px; }\nheader { margin-bottom: 32px; }\n.tool { margin: 0; color: var(--muted); font-size: 14px; }\nh1 { margin: 4px 0 4px; font-size: 22px; line-height: 1.3; font-weight: 600; overflow-wrap: anywhere; }\n.count { margin: 0; color: var(--muted); font-size: 14px; }\n.result { padding: 20px 0 24px; border-top: 1px solid var(--rule); }\n.head { display: flex; align-items: baseline; gap: 12px; min-width: 0; }\n.rank { flex: none; width: 2.25rem; color: var(--muted); font-variant-numeric: tabular-nums; font-weight: 600; }\n.file { flex: 1; min-width: 0; font: 14px/1.4 var(--code); overflow-wrap: anywhere; }\n.score { flex: none; font: 14px/1.4 var(--code); color: var(--muted); font-variant-numeric: tabular-nums; }\n.score:empty { display: none; }\n.meter { display: block; height: 3px; margin: 8px 0 12px; background: var(--track); border-radius: 2px; overflow: hidden; }\n.meter::before { content: \"\"; display: block; height: 100%; width: calc(var(--s) * 1%); background: var(--accent); }\npre {\n  margin: 0;\n  padding: 12px 14px;\n  background: var(--code-bg);\n  border-radius: 4px;\n  font: 13.5px/1.55 var(--code);\n  tab-size: 4;\n  overflow-x: auto;\n  white-space: pre;\n}\npre:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }\n.result:first-of-type { border-top: 2px solid var(--fg); padding-top: 24px; }\n.result:first-of-type .rank { color: var(--accent); font-size: 28px; line-height: 1; }\n.result:first-of-type .file { font-size: 15px; font-weight: 600; }\n.result:first-of-type .score { color: var(--fg); font-size: 15px; }\n.result:first-of-type .meter { height: 6px; border-radius: 3px; }\n.result:first-of-type pre { font-size: 14px; }\n@media print {\n  :root { --bg: #fff; --fg: #000; --muted: #444; --rule: #bbb; --code-bg: #fff; --track: #ddd; --accent: #000; }\n  body { font-size: 11pt; }\n  .page { max-width: none; padding: 0; }\n  pre { white-space: pre-wrap; overflow-wrap: anywhere; overflow: visible; border: 1px solid var(--rule); }\n  .head, .meter { break-after: avoid; }\n  .meter { print-color-adjust: exact; -webkit-print-color-adjust: exact; }\n}\n.answer { margin: 0 0 24px; padding: 14px 16px; border-left: 3px solid var(--accent); background: var(--code-bg); border-radius: 4px; white-space: pre-wrap; overflow-wrap: anywhere; }\n.answer:empty { display: none; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n<header>\n<p class=\"tool\">sys1grep</p>\n<h1 lang=\"\">{{query}}</h1>\n<p class=\"count\">Best first. Results: {{count}}</p>\n</header>\n<section class=\"answer\" lang=\"\">{{answer}}</section>\n<main>\n<!--result-->\n<article class=\"result\">\n<div class=\"head\"><span class=\"rank\">{{rank}}</span><span class=\"file\">{{file}}</span><span class=\"score\">{{score}}</span></div>\n<span class=\"meter\" style=\"--s:{{score_pct}}\" role=\"meter\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"{{score_pct}}\" aria-label=\"relevance of result {{rank}}\"></span>\n<pre tabindex=\"0\" lang=\"\" aria-label=\"lines of result {{rank}}\">{{lines}}</pre>\n</article>\n<!--/result-->\n</main>\n</div>\n</body>\n</html>\n","/sys1grep/templates/print.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{title}}</title>\n<style>\n@page { margin: 18mm 16mm; }\n* { box-sizing: border-box; }\nbody {\n  margin: 0;\n  background: #fff;\n  color: #000;\n  font: 11pt/1.45 Georgia, \"Times New Roman\", \"Hiragino Mincho ProN\", \"Noto Serif CJK JP\", \"Noto Serif\", serif;\n}\n.page { max-width: 90ch; margin: 0 auto; padding: 32px 16px; }\nh1 { margin: 0 0 4pt; font-size: 16pt; font-weight: normal; overflow-wrap: anywhere; }\n.count { margin: 0 0 18pt; font-style: italic; }\n.result { margin: 0 0 14pt; }\nh2 { margin: 0 0 4pt; font-size: 11pt; font-weight: bold; break-after: avoid; overflow-wrap: anywhere; }\n.file { font: 10pt ui-monospace, Menlo, Consolas, \"Liberation Mono\", monospace; font-weight: normal; }\n.score:empty { display: none; }\n.score::before { content: \"p = \"; font-weight: normal; }\n.score { font-weight: normal; }\npre {\n  margin: 0;\n  padding: 0 0 0 10pt;\n  border-left: 1pt solid #000;\n  font: 9.5pt/1.4 ui-monospace, Menlo, Consolas, \"Liberation Mono\", monospace;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  tab-size: 4;\n}\n.answer { margin: 0 0 1em; white-space: pre-wrap; overflow-wrap: anywhere; }\n.answer:empty { display: none; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n<h1 lang=\"\">{{query}}</h1>\n<p class=\"count\">sys1grep, results best first: {{count}}</p>\n<section class=\"answer\" lang=\"\">{{answer}}</section>\n<!--result-->\n<section class=\"result\">\n<h2>{{rank}}. <span class=\"file\">{{file}}</span> <span class=\"score\">{{score}}</span></h2>\n<pre lang=\"\">{{lines}}</pre>\n</section>\n<!--/result-->\n</div>\n</body>\n</html>\n","/sys1grep/templates/search.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>{{title}}</title>\n<style>\n:root {\n  --bg: #fff;\n  --fg: #202124;\n  --muted: #5f6368;\n  --rule: #dadce0;\n  --title: #1a0dab;\n  --url: #188038;\n  --snippet-bg: #f8f9fa;\n  --mark: #fff3b0;\n  --box-shadow: 0 1px 6px rgba(32, 33, 36, .28);\n  --chrome: arial, \"Helvetica Neue\", \"Hiragino Sans\", \"Noto Sans CJK JP\", \"Noto Sans\", sans-serif;\n  --code: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n    --bg: #202124;\n    --fg: #e8eaed;\n    --muted: #9aa0a6;\n    --rule: #3c4043;\n    --title: #8ab4f8;\n    --url: #81c995;\n    --snippet-bg: #2a2b2e;\n    --mark: #5c5200;\n    --box-shadow: 0 1px 6px rgba(0, 0, 0, .6);\n  }\n}\n* { box-sizing: border-box; }\nhtml { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }\nbody { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.58 var(--chrome); }\n.bar { border-bottom: 1px solid var(--rule); padding: 16px; }\n.bar-in { max-width: 652px; margin: 0 auto; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }\n.logo { font-size: 24px; font-weight: 700; letter-spacing: -.5px; color: var(--title); }\n.box {\n  flex: 1;\n  min-width: 200px;\n  padding: 10px 18px;\n  border: 1px solid var(--rule);\n  border-radius: 24px;\n  font-size: 16px;\n  line-height: 1.4;\n  overflow-wrap: anywhere;\n}\n.box:hover { box-shadow: var(--box-shadow); border-color: transparent; }\n.page { max-width: 652px; margin: 0 auto; padding: 0 16px 64px; }\n.stats { margin: 16px 0 8px; color: var(--muted); font-size: 14px; }\n.result { padding: 14px 0 10px; }\n.url { color: var(--url); font-size: 14px; line-height: 1.3; }\n.file { overflow-wrap: anywhere; }\n.file:empty::before { content: \"(standard input)\"; }\n.title {\n  margin: 4px 0 6px;\n  color: var(--title);\n  font-size: 20px;\n  line-height: 1.3;\n  font-weight: 400;\n}\n.title .score { margin-left: 8px; color: var(--muted); font-size: 14px; font-variant-numeric: tabular-nums; }\n.title .score:empty { display: none; }\n.relevance { display: inline-block; vertical-align: middle; width: 56px; height: 4px; margin-left: 8px; background: var(--rule); border-radius: 2px; overflow: hidden; }\n.relevance::before { content: \"\"; display: block; height: 100%; width: calc(var(--s) * 1%); background: var(--url); }\npre {\n  margin: 0;\n  padding: 8px 12px;\n  background: var(--snippet-bg);\n  border-left: 3px solid var(--rule);\n  border-radius: 0 4px 4px 0;\n  font: 13px/1.55 var(--code);\n  tab-size: 4;\n  overflow-x: auto;\n  white-space: pre;\n}\nmark { background: var(--mark); color: inherit; border-radius: 2px; }\npre:focus-visible { outline: 2px solid var(--title); outline-offset: 2px; }\n.result:first-of-type pre { border-left-color: var(--url); }\n@media print {\n  :root { --bg: #fff; --fg: #000; --muted: #444; --rule: #bbb; --title: #000; --url: #000; --snippet-bg: #fff; }\n  .bar { padding-top: 0; }\n  .box:hover { box-shadow: none; }\n  pre { white-space: pre-wrap; overflow-wrap: anywhere; overflow: visible; }\n  .title, .url { break-after: avoid; }\n  .relevance { print-color-adjust: exact; -webkit-print-color-adjust: exact; }\n}\n.answer { margin: 16px 0 8px; padding: 12px 16px; border-left: 3px solid var(--url); background: var(--snippet-bg); border-radius: 4px; white-space: pre-wrap; overflow-wrap: anywhere; }\n.answer:empty { display: none; }\n</style>\n</head>\n<body>\n<div class=\"bar\"><div class=\"bar-in\">\n<span class=\"logo\">sys1grep</span>\n<div class=\"box\" lang=\"\">{{query}}</div>\n</div></div>\n<div class=\"page\">\n<p class=\"stats\">About {{count}} results, best first</p>\n<section class=\"answer\" lang=\"\">{{answer}}</section>\n<main>\n<!--result-->\n<article class=\"result\">\n<div class=\"url\">Result {{rank}}</div>\n<h2 class=\"title\" lang=\"\"><span class=\"file\">{{file}}</span><span class=\"score\">{{score}}</span><span class=\"relevance\" style=\"--s:{{score_pct}}\" role=\"meter\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"{{score_pct}}\" aria-label=\"relevance of result {{rank}}\"></span></h2>\n<pre tabindex=\"0\" lang=\"\" aria-label=\"lines of result {{rank}}\">{{lines}}</pre>\n</article>\n<!--/result-->\n</main>\n</div>\n</body>\n</html>\n","/sys1grep/templates/terminal.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"dark\">\n<title>{{title}}</title>\n<style>\n:root {\n  --bg: #0d0f10;\n  --fg: #d7dad6;\n  --dim: #7c837e;\n  --prompt: #8fcf6a;\n  --file: #d38ad8;\n  --sep: #5fb8c6;\n  --score: #8fcf6a;\n  --mono: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n}\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.5 var(--mono); }\n.page { max-width: 120ch; margin: 0 auto; padding: 24px 16px 48px; }\n.cmd { margin: 0 0 4px; overflow-wrap: anywhere; }\n.cmd::before { content: \"sys1grep: \"; color: var(--prompt); }\n.count { margin: 0 0 20px; color: var(--dim); }\n.result { margin: 0 0 20px; }\n.head { margin: 0; color: var(--sep); overflow-wrap: anywhere; }\n.file { color: var(--file); }\n.score { color: var(--score); }\n.score::before { content: \"[\"; color: var(--dim); }\n.score::after { content: \"]\"; color: var(--dim); }\n.score:empty { display: none; }\n.meter { display: inline-block; width: 10ch; height: 0.5em; margin-left: 1ch; border: 1px solid var(--dim); vertical-align: middle; }\n.meter::before { content: \"\"; display: block; height: 100%; width: calc(var(--s) * 1%); background: var(--score); }\npre { margin: 0; font: inherit; white-space: pre; overflow-x: auto; tab-size: 8; }\npre:focus-visible { outline: 1px dashed var(--sep); outline-offset: 2px; }\n@media print {\n  :root { --bg: #fff; --fg: #000; --dim: #555; --prompt: #000; --file: #000; --sep: #000; --score: #000; }\n  pre { white-space: pre-wrap; overflow-wrap: anywhere; }\n}\n.answer { margin: 0 0 1em; white-space: pre-wrap; overflow-wrap: anywhere; }\n.answer:empty { display: none; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n<p class=\"cmd\" lang=\"\">{{query}}</p>\n<p class=\"count\"># results: {{count}}, best first</p>\n<section class=\"answer\" lang=\"\">{{answer}}</section>\n<!--result-->\n<section class=\"result\">\n<p class=\"head\">{{rank}}. <span class=\"score\">{{score}}</span> <span class=\"file\">{{file}}</span><span class=\"meter\" style=\"--s:{{score_pct}}\" role=\"meter\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuenow=\"{{score_pct}}\" aria-label=\"relevance of result {{rank}}\"></span></p>\n<pre tabindex=\"0\" lang=\"\" aria-label=\"lines of result {{rank}}\">{{lines}}</pre>\n</section>\n<!--/result-->\n</div>\n</body>\n</html>\n"}
